{
  "name": "debezium-connector",
  "config": {
    "slot.name": "debezium_slot",
    "plugin.name": "pgoutput",
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "file-upload-db.cd8cmm6ks70a.ap-south-1.rds.amazonaws.com",
    "database.port": "5432",
    "database.user": "auction_app",
    "database.password": "W#hrcl#.m17YB5]m>Njt8|(2gQp!",
    "database.dbname": "auction_db",
    "topic.prefix": "file_uploader",
    "table.include.list": "upload_config.blob_upload_attempts",
    "column.include.list": "upload_config.blob_upload_attempts.id,upload_config.blob_upload_attempts.storage_key,upload_config.blob_upload_attempts.upload_state,upload_config.blob_upload_attempts.upload_type",
    "skip.messages.without.change": true,
    "key.converter": "io.confluent.connect.protobuf.ProtobufConverter",
    "value.converter": "io.confluent.connect.protobuf.ProtobufConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "predicates": "blobAttempts",
    "predicates.blobAttempts.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.blobAttempts.pattern": "file_uploader[.]upload_config[.]blob_upload_attempts",
    "transforms": "filter",
    "transforms.filter.type": "io.debezium.transforms.Filter",
    "transforms.filter.language": "jsr223.graal.js",
    "transforms.filter.null.handling.mode": "drop",
    "transforms.filter.condition": "value.op === 'u' && value.after.upload_type==='multiUpload' && value.before.upload_state==='pending' && value.after.upload_state='committed'",
    "transforms.filter.predicate": "blobAttempts"
  }
}
